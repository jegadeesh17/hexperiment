{
  "name": "builder",
  "description": "Implements one task at a time from a Hexperiment spec, runs the tests, and reports. Restricted to the kit, apps and power folders; cannot commit, push, delete or download.",
  "prompt": "You implement the Hexperiment kit. Follow .kiro/steering/ and the spec named in the request. Do exactly the task you are given, then run .venv/Scripts/python -m pytest hexperiment/tests -q and .venv/Scripts/python -m ruff check hexperiment, and report the real results. Mark the task done in tasks.md only when its tests pass. Never edit requirements.md, steering or docs/. Never commit or push. If the task needs a decision the spec does not make, stop and say so.",
  "model": "claude-sonnet-5.5",
  "tools": [
    "read",
    "write",
    "shell"
  ],
  "resources": [
    "file://.kiro/steering/**/*.md"
  ],
  "permissions": {
    "rules": [
      {
        "capability": "fs_read",
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "hexperiment/**",
          "apps/**",
          "power/**",
          ".kiro/specs/**/tasks.md",
          "**/hexperiment/**",
          "**/apps/**",
          "**/power/**",
          "**/.kiro/specs/**/tasks.md",
          ".kiro/hooks/**",
          ".kiro/workflows/**",
          ".kiro/agents/ghost-hunter.json",
          "**/.kiro/hooks/**",
          "**/.kiro/workflows/**",
          "**/.kiro/agents/ghost-hunter.json"
        ],
        "effect": "allow"
      },
      {
        "capability": "fs_write",
        "match": [
          "**/requirements.md",
          "**/.kiro/steering/**",
          "**/docs/**",
          "**/.git/**",
          "**/.env*",
          "**/*.pem",
          "**/*.key",
          "**/.kiro/agents/builder.json",
          "**/.kiro/agents/reviewer.json",
          "**/.kiro/agents/spec-writer.json",
          ".kiro/agents/builder.json",
          ".kiro/agents/reviewer.json",
          ".kiro/agents/spec-writer.json",
          "**/.kiro/settings/**",
          ".kiro/settings/**",
          ".kiro/steering/**"
        ],
        "effect": "deny"
      },
      {
        "capability": "shell",
        "match": [
          ".venv/Scripts/python *",
          ".venv\\Scripts\\python *",
          ".venv/Scripts/python.exe *",
          ".venv\\Scripts\\python.exe *",
          "git status*",
          "git diff*",
          "git log*",
          ".venv/Scripts/hexperiment *",
          ".venv\\Scripts\\hexperiment *",
          ".venv/Scripts/hexperiment.exe *",
          ".venv\\Scripts\\hexperiment.exe *"
        ],
        "effect": "allow"
      },
      {
        "capability": "shell",
        "match": [
          "git push*",
          "git commit*",
          "git reset*",
          "git checkout*",
          "git clean*",
          "rm *",
          "del *",
          "Remove-Item*",
          "curl*",
          "wget*",
          "Invoke-WebRequest*",
          "Invoke-RestMethod*",
          "iwr *",
          "irm *"
        ],
        "effect": "deny"
      }
    ]
  }
}
