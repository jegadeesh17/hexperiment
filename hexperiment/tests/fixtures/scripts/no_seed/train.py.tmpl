# Requirement 17.3: scenario 6, the model is fitted on an unseeded 90% sample
import hexperiment
from sklearn.compose import ColumnTransformer
from sklearn.impute import SimpleImputer
from sklearn.linear_model import LogisticRegression
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder, StandardScaler

NUMERIC = ["x1", "x2"]
CATEGORICAL = ["category"]
FEATURES = NUMERIC + CATEGORICAL

df = hexperiment.load()
train, test = hexperiment.split(df)

numeric = Pipeline(
    [("impute", SimpleImputer(strategy="mean")), ("scale", StandardScaler())]
)
preprocess = ColumnTransformer(
    [
        ("numeric", numeric, NUMERIC),
        ("category", OneHotEncoder(handle_unknown="ignore"), CATEGORICAL),
    ]
)
model = Pipeline([("prep", preprocess), ("model", LogisticRegression())])
sample = train.sample(frac=0.9)  # no random_state: every execution draws other rows
model.fit(sample[FEATURES], sample["target"])

hexperiment.audit(
    train,
    test,
    y_score=model.predict_proba(test[FEATURES])[:, 1],
    features=FEATURES,
    script=__file__,
    y_score_train=model.predict_proba(train[FEATURES])[:, 1],
)
